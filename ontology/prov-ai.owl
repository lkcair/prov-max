    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:range rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:comment xml:lang="en">The failed step this step retries.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Tool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">tool</rdfs:label>
    <rdfs:comment xml:lang="en">A tool a call used.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#blamedAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">blamed agent</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#FailureAttribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:comment xml:lang="en">The agent an attribution names as responsible.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The version of a template, model, document, or tool.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Retrieval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:label xml:lang="en">retrieval</rdfs:label>
    <rdfs:comment xml:lang="en">A lookup in a document store or an index.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#irreversible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">irreversible</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Effect"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">The effect cannot be undone.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Step">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">step</rdfs:label>
    <rdfs:comment xml:lang="en">A unit of work inside a run.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#toAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    <rdfs:label xml:lang="en">to agent</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Handoff"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:comment xml:lang="en">The agent that received the work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#outcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">outcome</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Check"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The decision of a check: pass, fail, block, approve, edit, reject, or cancel.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#sequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sequence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The position of a step or message in the order its channel delivered them.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#finishReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
