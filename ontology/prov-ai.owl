    <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:comment xml:lang="en">The closure of communication between activities.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Message">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">message</rdfs:label>
    <rdfs:comment xml:lang="en">Content passed between agents or to a model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#reason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">reason</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The stated reason for a routing, a check outcome, or a refusal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Routing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:label xml:lang="en">routing</rdfs:label>
    <rdfs:comment xml:lang="en">A step that chose which agent or branch runs next.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Effect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">effect</rdfs:label>
    <rdfs:comment xml:lang="en">A change a run made outside itself: a write, a message sent, or data disclosed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#Memory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <rdfs:label xml:lang="en">memory</rdfs:label>
    <rdfs:comment xml:lang="en">A store that outlives a run: long-term memory, a session store, or a board shared by agents.</rdfs:comment>
  </rdf:Description>
