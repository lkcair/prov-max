    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The resource an effect changed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/publisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n95baeb5ca90c4875807beee768a4ecf5b4">
    <rdf:first rdf:resource="https://w3id.org/prov-ai#accountableAgent"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#ModelCall">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:label xml:lang="en">model call</rdfs:label>
    <rdfs:comment xml:lang="en">One call to an AI model, such as a language model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#ToolCall">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:label xml:lang="en">tool call</rdfs:label>
    <rdfs:comment xml:lang="en">A call to a tool, a function, an API, or an MCP server.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#candidate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">candidate</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Routing"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
