    <rdfs:label xml:lang="en">used tool</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#ToolCall"/>
    <rdfs:range rdf:resource="https://w3id.org/prov-ai#Tool"/>
    <rdfs:comment xml:lang="en">The tool a call used.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#branch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">branch</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/prov-ai#Step"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The label of the parallel branch a step ran in.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/prov-ai#retryOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
